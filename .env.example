# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
TRUST_PROXY=false

# Supabase PostgreSQL
# Set USE_PGLITE=true for zero-setup offline local/test mode,
# or provide your Supabase PostgreSQL URI in DATABASE_URL with USE_PGLITE=false.
USE_PGLITE=false
AUTO_SEED_DEMO=false
DATABASE_URL=postgresql://postgres.<project-ref>:<your-db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Optional Supabase Storage (Backend-only service role key; never expose to frontend)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>
SUPABASE_STORAGE_BUCKET=kaafila-images

# Security
JWT_SECRET=replace_with_a_long_random_secret_before_deploying
JWT_EXPIRES_IN=7d

# Frontend Map Tile Provider (Vite client env)
VITE_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png
VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors &copy; CARTO
VITE_MAP_API_KEY=
