PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Supabase PostgreSQL (Transaction/Session Pooler or Direct URI from Supabase Dashboard)
DATABASE_URL=postgresql://postgres.<project-ref>:<your-db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
USE_PGLITE=false
AUTO_SEED_DEMO=false

# Optional Supabase Storage (for persistent cloud image uploads via service role key - backend only)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>
SUPABASE_STORAGE_BUCKET=kaafila-images

# Security
JWT_SECRET=replace_with_a_long_random_secret_before_deploying
JWT_EXPIRES_IN=7d
